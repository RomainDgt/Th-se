@article{wendl_strongly_2010,
	title = {Strongly {Fillable} {Contact} {Manifolds} and {J}-holomorphic {Foliations}},
	volume = {151},
	issn = {0012-7094},
	url = {http://arxiv.org/abs/0806.3193},
	doi = {10.1215/00127094-2010-001},
	abstract = {We prove that every strong symplectic ﬁlling of a planar contact manifold admits a symplectic Lefschetz ﬁbration over the disk, and every strong ﬁlling of T 3 similarly admits a Lefschetz ﬁbration over the annulus. It follows that strongly ﬁllable planar contact structures are also Stein ﬁllable, and all strong ﬁllings of T 3 are equivalent up to symplectic deformation and blowup. These constructions result from a compactness theorem for punctured J–holomorphic curves that foliate a convex symplectic manifold. We use it also to show that the compactly supported symplectomorphism group on T ∗T 2 is contractible, and to deﬁne an obstruction to strong ﬁllability that yields a nongauge-theoretic proof of Gay’s recent nonﬁllability result [Gay06] for contact manifolds with positive Giroux torsion.},
	language = {en},
	number = {3},
	urldate = {2025-07-11},
	journal = {Duke Mathematical Journal},
	author = {Wendl, Chris},
	month = feb,
	year = {2010},
	note = {arXiv:0806.3193 [math]},
	keywords = {Mathematics - Symplectic Geometry, Mathematics - Analysis of PDEs},
	annote = {Comment: 44 pages, 2 figures; v.3 has a few significant improvements to the main results: We now classify all strong fillings and exact fillings of T{\textasciicircum}3 (without assuming Stein), and also show that a planar contact manifold is strongly fillable if and only if all its planar open books have monodromy generated by right-handed Dehn twists. To appear in Duke Math. J},
	file = {PDF:/home/E18F527X/snap/zotero-snap/common/Zotero/storage/TF93BV7E/Wendl - 2010 - Strongly Fillable Contact Manifolds and J-holomorphic Foliations.pdf:application/pdf},
}

